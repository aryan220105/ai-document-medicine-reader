# LLM (Groq is OpenAI-compatible). Multiple keys enable automatic failover on rate limits.
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_FALLBACK_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1

APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=10

TESSERACT_LANG=eng+hin+kan
TESSERACT_CMD=

DATA_DIR=../data
KNOWLEDGE_BASE_DIR=knowledge_base
