APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
DATA_DIR=./data
KNOWLEDGE_BASE_DIR=knowledge_base

TESSERACT_LANG=eng+hin+kan
TESSERACT_CMD=

VECTOR_STORE=chroma
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENABLE_LEXICAL_RETRIEVAL_FALLBACK=true
USE_LIGHT_EMBEDDINGS=false

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
EXTERNAL_AI_ENABLED=false
GROQ_TIMEOUT_SECONDS=30

PERSIST_USER_VALUES=false
LOG_LEVEL=INFO
KNOWN_FORM_MATCH_THRESHOLD=0.42
FIELD_IOU_MERGE=0.45
