APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
DATA_DIR=./data
KNOWLEDGE_BASE_DIR=knowledge_base

TESSERACT_LANG=eng+hin+kan+urd
TESSERACT_CMD=

VECTOR_STORE=chroma
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENABLE_LEXICAL_RETRIEVAL_FALLBACK=true
USE_LIGHT_EMBEDDINGS=false

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
EXTERNAL_AI_ENABLED=false
GROQ_TIMEOUT_SECONDS=30

# Page interpreter. Reads each blank together with its column headers so that repeated
# captions on a ruled form can be told apart. Needs EXTERNAL_AI_ENABLED=true.
# Smaller batches cost more requests but keep each reply inside the model's output budget.
# Optional background lookup for the form itself, by its printed title. Needs one of
# Groq's "compound" models, which run a web search server-side; an ordinary chat model
# would answer from memory instead, which is not a search and is not acceptable here.
# Findings only fill gaps the form's own pages left; the paper always wins.
WEB_CONTEXT_ENABLED=false
GROQ_WEB_SEARCH_MODEL=groq/compound-mini

INTERPRETER_CLASSIFY_BATCH=10
INTERPRETER_DESCRIBE_BATCH=5

# Uploads are expensive (OCR per page, then model requests), so limit them per client.
UPLOAD_RATE_LIMIT=12
UPLOAD_RATE_WINDOW_SECONDS=300

PERSIST_USER_VALUES=false
LOG_LEVEL=INFO
KNOWN_FORM_MATCH_THRESHOLD=0.42
FIELD_IOU_MERGE=0.45
